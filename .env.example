SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///intellitrack.db
FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
 

# Email / SMTP Configuration
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=your-secure-smtp-password
MAIL_DEFAULT_SENDER=noreply@example.com
# Set MAIL_SUPPRESS_SEND=true for local development and testing to log emails without sending real messages
MAIL_SUPPRESS_SEND=true